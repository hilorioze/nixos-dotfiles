{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  enabledManagers: [
    'custom.regex',
    'github-actions',
    'nix',
  ],

  // nix manager is in beta and off by default
  nix: {
    enabled: true,

    // inputs without a `rev` in `flake.nix` are only refreshed by lock file maintenance
    lockFileMaintenance: {
      enabled: true,

      // lock file maintenance has its own schedule; match the update window below
      schedule: [
        '* 22-23 * * 0',
        '* 0-2 * * 1',
      ],
    },
  },

  customManagers: [
    {
      // containers are pinned as `"<image>:<tag>@sha256:<digest>"` wherever the string is written; untagged pins are left alone
      customType: 'regex',

      managerFilePatterns: [
        '/\\.nix$/',
      ],

      matchStrings: [
        '"(?<depName>[^"\\s:@]+):(?<currentValue>[^"\\s@]+)@(?<currentDigest>sha256:[0-9a-f]{64})"',
      ],

      datasourceTemplate: 'docker',
    },
  ],

  // private images on ghcr.io need `read:packages`, which only classic tokens have; the token lives in the mend app's credentials
  hostRules: [
    {
      hostType: 'docker',
      matchHost: 'ghcr.io',

      username: 'hilorioze',
      password: '{{ secrets.GHCR_PULL_TOKEN }}',
    },
  ],

  // leave three hours for builds before 7 am in ireland, including summer time; the mend app runs jobs about every 4 hours
  schedule: [
    '* 22-23 * * 0',
    '* 0-2 * * 1',
  ],

  prHourlyLimit: 0, // the default limit of 2 prs per hour can leave updates waiting past the schedule

  assignees: [
    'hilorioze',
  ],

  semanticCommits: 'enabled',
  semanticCommitType: 'chore',

  packageRules: [
    {
      matchManagers: [
        'github-actions',
      ],

      groupName: 'github-actions',

      semanticCommitScope: 'deps/github-actions',

      labels: [
        'dependencies',
        'github_actions',
        'automated',
      ],
    },

    {
      matchManagers: [
        'nix',
      ],

      semanticCommitScope: 'deps/nix',

      labels: [
        'dependencies',
        'nix',
        'flake',
        'automated',
      ],
    },

    {
      matchManagers: [
        'custom.regex',
      ],

      groupName: 'images',

      semanticCommitScope: 'deps/images',

      labels: [
        'dependencies',
        'docker',
        'automated',
      ],
    },
  ],
}
