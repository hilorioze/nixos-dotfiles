            ],
            "body_part": null,
            "cache_options": null,
            "compatibility_date": "2026-06-24",
            "compatibility_flags": [],
            "content": "const SERVICE = \"s3\";\nconst EMPTY_PAYLOAD_SHA256 = \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\";\n\nconst SECONDS_PER_MINUTE = 60;\nconst SECONDS_PER_HOUR = 60 * SECONDS_PER_MINUTE;\nconst SECONDS_PER_DAY = 24 * SECONDS_PER_HOUR;\n\nconst NIX_CACHE_INFO_EDGE_TTL_SECONDS = 1 * SECONDS_PER_HOUR; // 1 hour: cache metadata may change\nconst INDEX_HTML_EDGE_TTL_SECONDS = 1 * SECONDS_PER_HOUR; // 1 hour: landing page may change\nconst CACHE_OBJECT_EDGE_TTL_SECONDS = 30 * SECONDS_PER_DAY; // 30 days: cache objects are expected to be stable\nconst NON_200_CACHE_TTL_SECONDS = 0; // 0 seconds: do not cache non-200 responses\n\nconst NIX_BASE32 = \"0123456789abcdfghijklmnpqrsvwxyz\";\n\nconst narinfoRe = new RegExp(`^[${NIX_BASE32}]{32}\\\\.narinfo$`);\nconst narRe = new RegExp(`^nar/[${NIX_BASE32}]{52}\\\\.nar(\\\\.zst|\\\\.xz|\\\\.bz2)?$`);\nconst listingRe = new RegExp(`^[${NIX_BASE32}]{32}\\\\.ls$`);\nconst logRe = /^log\\/[a-zA-Z0-9+._?=-]+\\.drv$/;\nconst realisationsRe = /^realisations\\/[a-z0-9]+:[a-zA-Z0-9+/=]+![a-zA-Z0-9+._?=-]+\\.doi$/;\n\nexport default {\n  async fetch(request, env) {\n    const url = new URL(request.url);\n\n    if (request.method !== \"GET\" \u0026\u0026 request.method !== \"HEAD\") {\n      return new Response(\"Method Not Allowed\\n\", {\n        status: 405,\n        headers: {\n          Allow: \"GET, HEAD\",\n          \"Cache-Control\": \"no-store\",\n        },\n      });\n    }\n\n    const missing = missingEnv(env);\n    if (missing.length \u003e 0) {\n      return new Response(`Worker misconfigured: missing ${missing.join(\", \")}\\n`, {\n        status: 500,\n        headers: {\n          \"Cache-Control\": \"no-store\",\n        },\n      });\n    }\n\n    // Ignore query strings for better cache hits.\n    let key = url.pathname.replace(/^\\/+/, \"\");\n    if (key === \"\") key = \"index.html\";\n\n    key = safeDecode(key);\n\n    if (!isValidCachePath(key)) {\n      return new Response(\"Not Found\\n\", {\n        status: 404,\n        headers: {\n          \"Cache-Control\": \"no-store\",\n        },\n      });\n    }\n\n    const bucket = env.B2_BUCKET;\n    const endpoint = env.B2_ENDPOINT;\n    const region = env.B2_REGION;\n    const accessKeyId = env.B2_APPLICATION_KEY_ID;\n    const secretAccessKey = env.B2_APPLICATION_KEY;\n\n    const originHost = `${bucket}.${endpoint}`;\n    const canonicalPath = \"/\" + canonicalUri(key);\n    const originUrl = `https://${originHost}${canonicalPath}`;\n\n    // B2 HEAD requests were returning 403 on cache misses.\n    // Sign and send GET to B2, then return a bodyless response for client HEAD.\n    const originMethod = \"GET\";\n\n    const now = new Date();\n    const amzDate = toAmzDate(now);\n    const dateStamp = amzDate.slice(0, 8);\n\n    const originHeaders = new Headers();\n    originHeaders.set(\"x-amz-content-sha256\", EMPTY_PAYLOAD_SHA256);\n    originHeaders.set(\"x-amz-date\", amzDate);\n\n    const signedHeaders = [\"host\", \"x-amz-content-sha256\", \"x-amz-date\"];\n    const signedHeaderValues = {\n      host: originHost,\n      \"x-amz-content-sha256\": EMPTY_PAYLOAD_SHA256,\n      \"x-amz-date\": amzDate,\n    };\n\n    const range = request.headers.get(\"range\");\n    const useRange = range \u0026\u0026 key.startsWith(\"nar/\");\n\n    // Range is mainly useful for large NAR payloads.\n    // Do not cache range subrequests because they are partial responses.\n    if (useRange) {\n      originHeaders.set(\"range\", range);\n      signedHeaders.push(\"range\");\n      signedHeaderValues.range = range;\n    }\n\n    signedHeaders.sort();\n\n    originHeaders.set(\n      \"authorization\",\n      await awsV4Authorization({\n        method: originMethod,\n        canonicalPath,\n        region,\n        accessKeyId,\n        secretAccessKey,\n        amzDate,\n        dateStamp,\n        signedHeaders,\n        signedHeaderValues,\n      }),\n    );\n\n    const originResponse = await fetch(originUrl, {\n      method: originMethod,\n      headers: originHeaders,\n      cf: useRange\n        ? undefined\n        : {\n            cacheEverything: true,\n            cacheTtlByStatus: {\n              200: edgeTtlForKey(key),\n              \"201-599\": NON_200_CACHE_TTL_SECONDS,\n            },\n          },\n    });\n\n    const status = originResponse.status;\n    const responseHeaders = new Headers(originResponse.headers);\n\n    responseHeaders.delete(\"x-amz-request-id\");\n    responseHeaders.delete(\"x-amz-id-2\");\n    responseHeaders.delete(\"x-amz-version-id\");\n    responseHeaders.delete(\"server\");\n\n    responseHeaders.set(\"Access-Control-Allow-Origin\", \"*\");\n    responseHeaders.set(\"Cache-Control\", cacheControlForKey(key, status));\n\n    // Nix resumes an interrupted NAR download only if the response it was reading advertised range support.\n    // Partial responses come back without this header, so a second interruption would be fatal.\n    if (key.startsWith(\"nar/\") \u0026\u0026 (status === 200 || status === 206)) {\n      responseHeaders.set(\"Accept-Ranges\", \"bytes\");\n    }\n\n    // Metadata files are stored zstd-compressed.\n    // Do not set this for /nar/*.nar.zst because Nix handles NAR compression itself.\n    if (status === 200 \u0026\u0026 needsZstdContentEncoding(key)) {\n      responseHeaders.set(\"Content-Encoding\", \"zstd\");\n    } else {\n      responseHeaders.delete(\"Content-Encoding\");\n    }\n\n    if (request.method === \"HEAD\") {\n      return new Response(null, {\n        status,\n        statusText: originResponse.statusText,\n        headers: responseHeaders,\n      });\n    }\n\n    return new Response(originResponse.body, {\n      status,\n      statusText: originResponse.statusText,\n      headers: responseHeaders,\n    });\n  },\n};\n\nfunction missingEnv(env) {\n  return [\n    \"B2_BUCKET\",\n    \"B2_ENDPOINT\",\n    \"B2_REGION\",\n    \"B2_APPLICATION_KEY_ID\",\n    \"B2_APPLICATION_KEY\",\n  ].filter((name) =\u003e !env[name]);\n}\n\nfunction isValidCachePath(key) {\n  if (!key) return false;\n\n  if (\n    key === \"..\" ||\n    key.startsWith(\"../\") ||\n    key.endsWith(\"/..\") ||\n    key.includes(\"/../\")\n  ) {\n    return false;\n  }\n\n  if (key === \"nix-cache-info\") return true;\n  if (key === \"index.html\") return true;\n\n  if (narinfoRe.test(key)) return true;\n  if (narRe.test(key)) return true;\n  if (listingRe.test(key)) return true;\n  if (logRe.test(key)) return true;\n  if (realisationsRe.test(key)) return true;\n\n  return false;\n}\n\nfunction needsZstdContentEncoding(key) {\n  return (\n    key.endsWith(\".narinfo\") ||\n    key.endsWith(\".ls\") ||\n    key.startsWith(\"log/\") ||\n    key.startsWith(\"realisations/\")\n  );\n}\n\nfunction edgeTtlForKey(key) {\n  if (key === \"nix-cache-info\") {\n    return NIX_CACHE_INFO_EDGE_TTL_SECONDS;\n  }\n\n  if (key === \"index.html\") {\n    return INDEX_HTML_EDGE_TTL_SECONDS;\n  }\n\n  return CACHE_OBJECT_EDGE_TTL_SECONDS;\n}\n\nfunction cacheControlForKey(key, status) {\n  if (status !== 200) {\n    return \"no-store\";\n  }\n\n  if (key === \"nix-cache-info\") {\n    return `public, max-age=${NIX_CACHE_INFO_EDGE_TTL_SECONDS}`;\n  }\n\n  if (key === \"index.html\") {\n    return `public, max-age=${INDEX_HTML_EDGE_TTL_SECONDS}`;\n  }\n\n  return `public, max-age=${CACHE_OBJECT_EDGE_TTL_SECONDS}, immutable`;\n}\n\nfunction canonicalUri(key) {\n  return key\n    .split(\"/\")\n    .map((part) =\u003e\n      encodeURIComponent(part).replace(/[!'()*]/g, (char) =\u003e\n        `%${char.charCodeAt(0).toString(16).toUpperCase()}`,\n      ),\n    )\n    .join(\"/\");\n}\n\nfunction safeDecode(value) {\n  try {\n    return decodeURIComponent(value);\n  } catch {\n    return value;\n  }\n}\n\nasync function awsV4Authorization({\n  method,\n  canonicalPath,\n  region,\n  accessKeyId,\n  secretAccessKey,\n  amzDate,\n  dateStamp,\n  signedHeaders,\n  signedHeaderValues,\n}) {\n  const signedHeadersString = signedHeaders.join(\";\");\n\n  const canonicalHeaders =\n    signedHeaders\n      .map((name) =\u003e `${name}:${normalizeHeaderValue(signedHeaderValues[name])}`)\n      .join(\"\\n\") + \"\\n\";\n\n  const canonicalRequest = [\n    method,\n    canonicalPath,\n    \"\",\n    canonicalHeaders,\n    signedHeadersString,\n    EMPTY_PAYLOAD_SHA256,\n  ].join(\"\\n\");\n\n  const credentialScope = `${dateStamp}/${region}/${SERVICE}/aws4_request`;\n\n  const stringToSign = [\n    \"AWS4-HMAC-SHA256\",\n    amzDate,\n    credentialScope,\n    await sha256Hex(canonicalRequest),\n  ].join(\"\\n\");\n\n  const signingKey = await getSigningKey(secretAccessKey, dateStamp, region, SERVICE);\n  const signature = await hmacHex(signingKey, stringToSign);\n\n  return (\n    `AWS4-HMAC-SHA256 ` +\n    `Credential=${accessKeyId}/${credentialScope}, ` +\n    `SignedHeaders=${signedHeadersString}, ` +\n    `Signature=${signature}`\n  );\n}\n\nfunction normalizeHeaderValue(value) {\n  return String(value || \"\").trim().replace(/\\s+/g, \" \");\n}\n\nfunction toAmzDate(date) {\n  return date.toISOString().replace(/[:-]/g, \"\").replace(/\\.\\d{3}Z$/, \"Z\");\n}\n\nasync function getSigningKey(secretAccessKey, dateStamp, region, service) {\n  const kDate = await hmacRaw(utf8(`AWS4${secretAccessKey}`), dateStamp);\n  const kRegion = await hmacRaw(kDate, region);\n  const kService = await hmacRaw(kRegion, service);\n\n  return hmacRaw(kService, \"aws4_request\");\n}\n\nasync function sha256Hex(value) {\n  return hex(await crypto.subtle.digest(\"SHA-256\", utf8(value)));\n}\n\nasync function hmacRaw(keyBytes, value) {\n  const key = await crypto.subtle.importKey(\n    \"raw\",\n    keyBytes,\n    { name: \"HMAC\", hash: \"SHA-256\" },\n    false,\n    [\"sign\"],\n  );\n\n  return new Uint8Array(await crypto.subtle.sign(\"HMAC\", key, utf8(value)));\n}\n\nasync function hmacHex(keyBytes, value) {\n  return hex(await hmacRaw(keyBytes, value));\n}\n\nfunction utf8(value) {\n  return new TextEncoder().encode(value);\n}\n\nfunction hex(buffer) {\n  return [...new Uint8Array(buffer)]\n    .map((byte) =\u003e byte.toString(16).padStart(2, \"0\"))\n    .join(\"\");\n}\n",
