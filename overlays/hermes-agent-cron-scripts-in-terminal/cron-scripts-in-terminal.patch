+def _run_job_script_in_terminal(
+    path: Path, workdir: Optional[str], script_timeout: int, interpreter: Optional[str] = None,
+) -> tuple[bool, str]:
+    """Run a validated script where the terminal tool runs its commands, so a remote backend (ssh,
+    docker, ...) keeps cron scripts off the gateway host too. The body goes over stdin: the backend
+    has no HERMES_HOME/scripts of its own. ``interpreter`` names a Python on the backend."""
+    try:
+        from tools.code_execution_tool import _get_or_create_env
+        env, _ = _get_or_create_env("cron-script")
+        if path.suffix.lower() in {".sh", ".bash"}:
+            command = "bash -s"
+        elif isinstance(interpreter, str) and interpreter.strip():
+            command = f"{shlex.quote(interpreter.strip())} -"
+        else:
+            command = "python3 -"
+        result = env.execute(command, cwd=workdir or "", timeout=script_timeout, stdin_data=path.read_text())
+        output = (result.get("output") or "").strip()
+        try:
+            from agent.redact import redact_sensitive_text
+            output = redact_sensitive_text(output)
+        except Exception as e:
+            logger.warning("Failed to redact sensitive text from output: %s", e)
+            output = "[REDACTED - redaction failed]"
+        returncode = int(result.get("returncode") or 0)
+        if returncode != 0:
+            parts = [f"Script exited with code {returncode}"]
+            if output:
+                parts.append(f"output:\n{output}")
+            return False, "\n".join(parts)
+        return True, output
+    except Exception as exc:
+        return False, f"Script execution failed: {exc}"
+
