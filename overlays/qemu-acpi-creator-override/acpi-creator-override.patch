diff --git a/hw/i386/x86.c b/hw/i386/x86.c
index f80533d..425ce12 100644
--- a/hw/i386/x86.c
+++ b/hw/i386/x86.c
@@ -309,6 +309,53 @@ static void x86_machine_set_oem_table_id(Object *obj, const char *value,
     strncpy(x86ms->oem_table_id, value, 8);
 }
 
+static char *x86_machine_get_acpi_creator_id(Object *obj, Error **errp)
+{
+    X86MachineState *x86ms = X86_MACHINE(obj);
+
+    return g_strdup(x86ms->acpi_creator_id);
+}
+
+static void x86_machine_set_acpi_creator_id(Object *obj, const char *value,
+                                            Error **errp)
+{
+    X86MachineState *x86ms = X86_MACHINE(obj);
+    size_t len = strlen(value);
+
+    if (len > 4) {
+        error_setg(errp,
+                   "User specified "X86_MACHINE_ACPI_CREATOR_ID
+                   " value is bigger than "
+                   "4 bytes in size");
+        return;
+    }
+
+    strncpy(x86ms->acpi_creator_id, value, 4);
+}
+
+static void x86_machine_get_acpi_creator_revision(Object *obj,
+                                                   Visitor *v,
+                                                   const char *name,
+                                                   void *opaque,
+                                                   Error **errp)
+{
+    X86MachineState *x86ms = X86_MACHINE(obj);
+    uint32_t acpi_creator_revision = x86ms->acpi_creator_revision;
+
+    visit_type_uint32(v, name, &acpi_creator_revision, errp);
+}
+
+static void x86_machine_set_acpi_creator_revision(Object *obj,
+                                                   Visitor *v,
+                                                   const char *name,
+                                                   void *opaque,
+                                                   Error **errp)
+{
+    X86MachineState *x86ms = X86_MACHINE(obj);
+
+    visit_type_uint32(v, name, &x86ms->acpi_creator_revision, errp);
+}
+
 static void x86_machine_get_bus_lock_ratelimit(Object *obj, Visitor *v,
                                 const char *name, void *opaque, Error **errp)
 {
@@ -368,6 +415,8 @@ static void x86_machine_initfn(Object *obj)
     x86ms->pci_irq_mask = ACPI_BUILD_PCI_IRQS;
     x86ms->oem_id = g_strndup(ACPI_BUILD_APPNAME6, 6);
     x86ms->oem_table_id = g_strndup(ACPI_BUILD_APPNAME8, 8);
+    x86ms->acpi_creator_id = g_strndup(ACPI_BUILD_APPNAME8, 4);
+    x86ms->acpi_creator_revision = 1;
     x86ms->bus_lock_ratelimit = 0;
     x86ms->above_4g_mem_start = 4 * GiB;
 }
@@ -428,6 +477,22 @@ static void x86_machine_class_init(ObjectClass *oc, const void *data)
                                           "in ACPI table header."
                                           "The string may be up to 8 bytes in size");
 
