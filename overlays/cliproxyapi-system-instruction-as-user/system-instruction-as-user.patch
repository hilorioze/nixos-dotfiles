+
 	"github.com/MoeForge/moego/ojson"
 	translatorcommon "github.com/router-for-me/CLIProxyAPI/v8/internal/translator/common"
 )
@@ -207,3 +209,61 @@ func EnsureGeminiBoundaryUserContentDoc(doc *ojson.Doc, path string) bool {
 	trailing := EnsureGeminiTrailingUserContentDoc(doc, path)
 	return leading || trailing
 }
+
+// MoveSystemInstructionToLeadingUserContentDoc moves the system instruction of the
+// request at requestPath into its first user turn in place on doc. The instruction
+// parts are placed before the turn's own parts; when the contents do not start with
+// a user turn, a user turn carrying only the instruction is inserted first.
+func MoveSystemInstructionToLeadingUserContentDoc(doc *ojson.Doc, requestPath string) bool {
+	if doc == nil || doc.Len() == 0 {
+		return false
+	}
+	instructionPaths := []string{requestPath + ".systemInstruction", requestPath + ".system_instruction"}
+	var instructionParts [][]byte
+	for _, path := range instructionPaths {
+		instruction := doc.Get(path)
+		if instruction.Type == ojson.String {
+			if text := instruction.String(); text != "" {
+				part, errMarshal := json.Marshal(map[string]string{"text": text})
+				if errMarshal != nil {
+					return false
+				}
+				instructionParts = append(instructionParts, part)
+			}
+			continue
+		}
+		for _, part := range instruction.Get("parts").Array() {
+			instructionParts = append(instructionParts, []byte(part.Raw))
+		}
+	}
+	if len(instructionParts) == 0 {
+		return false
+	}
+
+	contentsPath := requestPath + ".contents"
+	contentArray := doc.Get(contentsPath).Array()
+	if len(contentArray) > 0 && contentArray[0].Get("role").String() != "model" {
+		parts := instructionParts
+		for _, part := range contentArray[0].Get("parts").Array() {
+			parts = append(parts, []byte(part.Raw))
+		}
+		if errSet := doc.SetRawBytes(contentsPath+".0.parts", translatorcommon.JoinRawArray(parts)); errSet != nil {
+			return false
+		}
+	} else {
+		turn := []byte(`{"role":"user","parts":` + string(translatorcommon.JoinRawArray(instructionParts)) + `}`)
+		contentItems := make([][]byte, 0, len(contentArray)+1)
+		contentItems = append(contentItems, turn)
+		for _, content := range contentArray {
+			contentItems = append(contentItems, []byte(content.Raw))
+		}
+		if errSet := doc.SetRawBytes(contentsPath, translatorcommon.JoinRawArray(contentItems)); errSet != nil {
+			return false
+		}
+	}
+
+	for _, path := range instructionPaths {
+		_ = doc.Delete(path)
+	}
+	return true
+}
