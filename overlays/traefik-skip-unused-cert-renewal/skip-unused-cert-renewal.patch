index cee62ebb..23236aca 100644
--- a/pkg/rules/parser.go
+++ b/pkg/rules/parser.go
@@ -120,6 +120,20 @@ func (tree *Tree) ParsePositiveMatchers(matchers []string) []string {
 	}
