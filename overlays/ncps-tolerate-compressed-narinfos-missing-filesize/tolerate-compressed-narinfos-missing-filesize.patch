+// fixNarInfoFileHash updates the narinfo file_hash column in the database.
+func (c *Cache) fixNarInfoFileHash(
+	ctx context.Context,
+	hash string,
+	fileHash string,
+) error {
+	ctx, span := tracer.Start(
+		ctx,
+		"cache.fixNarInfoFileHash",
+		trace.WithSpanKind(trace.SpanKindInternal),
+		trace.WithAttributes(
+			attribute.String("narinfo_hash", hash),
+			attribute.String("file_hash", fileHash),
+		),
+	)
+	defer span.End()
+
+	zerolog.Ctx(ctx).
+		Info().
+		Str("file_hash", fileHash).
+		Msg("updating narinfo file hash in the database")
+
+	return c.withTransaction(ctx, "fixNarInfoFileHash", func(qtx database.Querier) error {
+		return qtx.UpdateNarInfoFileHash(ctx, database.UpdateNarInfoFileHashParams{
+			Hash:     hash,
+			FileHash: sql.NullString{String: fileHash, Valid: true},
+		})
+	})
+}
