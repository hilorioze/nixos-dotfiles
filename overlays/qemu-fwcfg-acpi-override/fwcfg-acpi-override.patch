diff --git a/hw/i386/x86.c b/hw/i386/x86.c
index 425ce12..ad85acd 100644
--- a/hw/i386/x86.c
+++ b/hw/i386/x86.c
@@ -356,6 +356,46 @@ static void x86_machine_set_acpi_creator_revision(Object *obj,
     visit_type_uint32(v, name, &x86ms->acpi_creator_revision, errp);
 }
 
+static char *x86_machine_get_fw_cfg_acpi_name(Object *obj, Error **errp)
+{
+    X86MachineState *x86ms = X86_MACHINE(obj);
+
+    return g_strdup(x86ms->fw_cfg_acpi_name);
+}
+
+static void x86_machine_set_fw_cfg_acpi_name(Object *obj, const char *value,
+                                             Error **errp)
+{
+    X86MachineState *x86ms = X86_MACHINE(obj);
+    size_t len = strlen(value);
+
+    if (len > 4) {
+        error_setg(errp,
+                   "User specified "X86_MACHINE_FW_CFG_ACPI_NAME
+                   " value is bigger than "
+                   "4 bytes in size");
+        return;
+    }
+
+    g_strlcpy(x86ms->fw_cfg_acpi_name, value, 5);
+}
+
+static char *x86_machine_get_fw_cfg_acpi_hid(Object *obj, Error **errp)
+{
+    X86MachineState *x86ms = X86_MACHINE(obj);
+
+    return g_strdup(x86ms->fw_cfg_acpi_hid);
+}
+
+static void x86_machine_set_fw_cfg_acpi_hid(Object *obj, const char *value,
+                                            Error **errp)
+{
+    X86MachineState *x86ms = X86_MACHINE(obj);
+
+    g_free(x86ms->fw_cfg_acpi_hid);
+    x86ms->fw_cfg_acpi_hid = g_strdup(value);
+}
+
 static void x86_machine_get_bus_lock_ratelimit(Object *obj, Visitor *v,
                                 const char *name, void *opaque, Error **errp)
 {
@@ -417,6 +457,8 @@ static void x86_machine_initfn(Object *obj)
     x86ms->oem_table_id = g_strndup(ACPI_BUILD_APPNAME8, 8);
     x86ms->acpi_creator_id = g_strndup(ACPI_BUILD_APPNAME8, 4);
     x86ms->acpi_creator_revision = 1;
+    x86ms->fw_cfg_acpi_name = g_strdup("FWCF");
+    x86ms->fw_cfg_acpi_hid = g_strdup("QEMU0002");
     x86ms->bus_lock_ratelimit = 0;
     x86ms->above_4g_mem_start = 4 * GiB;
 }
@@ -493,6 +535,20 @@ static void x86_machine_class_init(ObjectClass *oc, const void *data)
                                           "Override the default value of field Creator Revision "
                                           "in ACPI table header.");
 
+    object_class_property_add_str(oc, X86_MACHINE_FW_CFG_ACPI_NAME,
+                                  x86_machine_get_fw_cfg_acpi_name,
+                                  x86_machine_set_fw_cfg_acpi_name);
+    object_class_property_set_description(oc, X86_MACHINE_FW_CFG_ACPI_NAME,
+                                          "Override the default name of the ACPI fw_cfg device. "
+                                          "The name may be up to 4 bytes in size");
+
+    object_class_property_add_str(oc, X86_MACHINE_FW_CFG_ACPI_HID,
+                                  x86_machine_get_fw_cfg_acpi_hid,
+                                  x86_machine_set_fw_cfg_acpi_hid);
+    object_class_property_set_description(oc, X86_MACHINE_FW_CFG_ACPI_HID,
+                                          "Override the default hardware ID of the ACPI fw_cfg "
+                                          "device.");
+
     object_class_property_add(oc, X86_MACHINE_BUS_LOCK_RATELIMIT, "uint64_t",
                                 x86_machine_get_bus_lock_ratelimit,
                                 x86_machine_set_bus_lock_ratelimit, NULL, NULL);
