diff --git a/lib/src/aia_openssl.c b/lib/src/aia_openssl.c
index d3b36f2..6a87722 100644
--- a/lib/src/aia_openssl.c
+++ b/lib/src/aia_openssl.c
@@ -98,7 +98,11 @@ void *chiaki_aia_trust_store(CURL *connection)
 		return store;
 	}
 #endif
-	if((!file && !path) || X509_STORE_load_locations(store, file, path) != 1)
+	if(!file && !path) {
+		if(X509_STORE_set_default_paths(store) != 1)
+			goto error;
+	}
+	else if(X509_STORE_load_locations(store, file, path) != 1)
 		goto error;
 	return store;
 error:
@@ -111,6 +115,12 @@ void chiaki_aia_trust_store_free(void *store)
 	X509_STORE_free(store);
 }
 
+const char *chiaki_aia_default_ca_file(void)
+{
+	const char *file = getenv(X509_get_default_cert_file_env());
+	return file ? file : X509_get_default_cert_file();
+}
+
 bool chiaki_aia_verify_with_store(
 	const uint8_t *leaf_der, size_t leaf_len,
 	const uint8_t *const *candidates, const size_t *candidate_lens, size_t candidate_count,
