@@ -55,6 +55,8 @@ typedef struct {
 
 void *chiaki_aia_trust_store(CURL *connection);
 void chiaki_aia_trust_store_free(void *store);
+// OpenSSL's default CA file, which curl's CA fallback loads when no CA file or path is configured.
+const char *chiaki_aia_default_ca_file(void);
 bool chiaki_aia_verify_with_store(
