+// filterUpstreamPaths drops paths signed by one of the upstream cache key
+// names. Nix substitutes them together with their closures from the
+// upstream cache, so pathInfos is pruned to the paths still reachable from
+// the kept top-level paths without passing through an upstream path. The
+// narinfos keep their full References.
+func filterUpstreamPaths(topLevelPaths []string, pathInfos map[string]*PathInfo, keyNames []string) ([]string, map[string]*PathInfo) {
+	if len(keyNames) == 0 {
+		return topLevelPaths, pathInfos
+	}
+
+	localInfos := make(map[string]*PathInfo, len(pathInfos))
+
+nextPath:
+	for path, info := range pathInfos {
+		for _, sig := range info.Signatures {
+			if name, _, _ := strings.Cut(sig, ":"); slices.Contains(keyNames, name) {
+				continue nextPath
+			}
+		}
+
+		localInfos[path] = info
+	}
+
+	if len(localInfos) == len(pathInfos) {
+		return topLevelPaths, pathInfos
+	}
+
+	kept := make([]string, 0, len(topLevelPaths))
+
+	for _, topLevelPath := range topLevelPaths {
+		if _, ok := localInfos[topLevelPath]; ok {
+			kept = append(kept, topLevelPath)
+		}
+	}
+
+	prunedInfos := make(map[string]*PathInfo)
+
+	for _, reachable := range computeClosureMembership(kept, localInfos) {
+		for path := range reachable {
+			if info, ok := localInfos[path]; ok {
+				prunedInfos[path] = info
+			}
+		}
+	}
+
+	slog.Info(fmt.Sprintf("Skipping %d paths available from upstream caches", len(pathInfos)-len(prunedInfos)))
+
+	return kept, prunedInfos
+}
