+void DetachableTabBar::dragTabAsWindow(QMouseEvent *event)
+{
+    auto container = qobject_cast<TabbedViewContainer *>(parentWidget());
+    const int originalIndex = currentIndex();
+    _draggedTab = container->widget(originalIndex);
+
+    // Finish QTabBar's in-place move before starting the native drag.
+    QMouseEvent release(QEvent::MouseButtonRelease, event->position(), event->globalPosition(), Qt::LeftButton, Qt::NoButton, event->modifiers());
+    QTabBar::mouseReleaseEvent(&release);
+    tabId = -1;
+
+    if (count() > 1) {
+        Q_EMIT detachTab(originalIndex);
+    }
+    QPointer<QWidget> floatingWindow = _draggedTab->window();
+    auto floatingBar = floatingWindow->findChild<DetachableTabBar *>();
+    const QPoint offset = floatingBar->mapTo(floatingWindow, floatingBar->tabRect(floatingBar->currentIndex()).center());
+
+    // Qt's toplevel drag distinguishes an outside drop from compositor-side cancellation.
+    auto mimeData = new QMimeData();
+    mimeData->setData(QStringLiteral("konsole/tab"), QByteArray());
+    QByteArray windowData;
+    QDataStream windowStream(&windowData, QIODevice::WriteOnly);
+    windowStream << reinterpret_cast<qintptr>(floatingWindow->windowHandle());
+    mimeData->setData(QStringLiteral("application/x-qt-mainwindowdrag-window"), windowData);
+    QByteArray positionData;
+    QDataStream positionStream(&positionData, QIODevice::WriteOnly);
+    positionStream << offset;
+    mimeData->setData(QStringLiteral("application/x-qt-mainwindowdrag-position"), positionData);
+
+    auto drag = new QDrag(this);
+    drag->setMimeData(mimeData);
+    QPointer<DetachableTabBar> guard(this);
+    const auto action = drag->exec(Qt::MoveAction);
+    if (!guard || !_draggedTab) {
+        return;
+    }
+
+    if (action == Qt::IgnoreAction && floatingWindow && floatingWindow != window()) {
+        Q_EMIT floatingBar->moveTabToWindow(floatingBar->currentIndex(), window());
+    }
+
+    const int index = container->indexOf(_draggedTab);
+    _draggedTab.clear();
+    if (index != -1) {
+        moveTab(index, originalIndex);
+        setCurrentIndex(originalIndex);
+    }
+}
