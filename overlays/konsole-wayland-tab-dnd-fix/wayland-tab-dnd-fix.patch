+void DetachableTabBar::dropEvent(QDropEvent *event)
+{
+    auto source = qobject_cast<DetachableTabBar *>(event->source());
+    if (!event->mimeData()->hasFormat(QStringLiteral("konsole/tab")) || source == nullptr || !source->_draggedTab) {
+        return;
+    }
+
+    auto container = source->_draggedTab->window()->findChild<TabbedViewContainer *>();
+    const int index = container->indexOf(source->_draggedTab);
+    if (index == -1) {
+        return;
+    }
+
+    event->acceptProposedAction();
+    if (container->window() != window()) {
+        auto bar = qobject_cast<DetachableTabBar *>(container->tabBar());
+        Q_EMIT bar->moveTabToWindow(index, window());
+    }
+}
