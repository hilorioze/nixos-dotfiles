{
  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "jnoortheen.nix-ide",
        "mkhl.direnv"
      ]
    },
    "zed": {
      "extensions": []
    }
  },
  "image": "ghcr.io/cachix/devenv/devcontainer:latest",
  "mounts": [
    "source=devcontainer-nix,target=/nix,type=volume"
  ],
  "onCreateCommand": "sudo sh -c 'printf \"accept-flake-config = true\\n\" >> /etc/nix/nix.conf' ",
  "overrideCommand": false,
  "updateContentCommand": "devenv test"
}
